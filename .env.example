DATABASE_URL=postgres://localhost/posturi_dev
GOOGLE_API_KEY=              # Gemini (3.1 Flash-Lite, 2.5 Flash)
ANTHROPIC_API_KEY=           # Claude (3.5 Haiku)
OPENAI_API_KEY=              # OpenAI (GPT-5 Nano, GPT-4o Mini)
DEEPSEEK_API_KEY=            # DeepSeek (V4-Flash)

# LLM selection. Precedence for every entry point (llm-schema.py, pipeline.py,
# quality_check.py): CLI flag > these vars > models_config.json "defaults".
# Leave blank to use the models_config.json default.
#
# LLM_PROVIDER        gemini | openai | anthropic | deepseek   (config default: gemini)
#                     pipeline.py cannot drive deepseek — the infer step has no branch for it.
# LLM_MODEL           model id from models_config.json; ignored when it does not
#                     belong to the selected provider, so switching provider on the
#                     command line does not require unsetting it.
# LLM_PROMPT_VERSION  v1 | v2 | v3 | v4                        (config default: v2; the cron pins v4)
LLM_PROVIDER=
LLM_MODEL=
LLM_PROMPT_VERSION=

# ---------------------------------------------------------------------------
# Deployment (deploy-php.sh, ops/run-pipeline.sh)
# ---------------------------------------------------------------------------
# The target used to live only in someone's shell history. Put it here so a deploy
# never depends on remembering it. Quote a leading ~ — unquoted it expands against
# the *local* home and the script will refuse the result.
#
# DEPLOY_HOST      user@host for rsync/ssh
# DEPLOY_PATH      remote document root (default: public_html)
# SITE_URL         checked for HTTP 200 after every deploy; blank skips the check
# HEALTHCHECK_URL  dead-man's-switch pinged by ops/run-pipeline.sh — /start on entry,
#                  bare on success, /fail on failure. Blank disables it. This is what
#                  tells you the cron stopped running, which a failure mail cannot.
DEPLOY_HOST=
DEPLOY_PATH=
SITE_URL=
HEALTHCHECK_URL=

# LLM balance pre-flight (ops/check-llm-balance.py, run first by ops/run-pipeline.sh).
# USD thresholds against the DeepSeek balance; blank uses the default.
# The balance is the DeepSeek ACCOUNT's, whichever API key reads it: other projects on
# the account spend from the same pot (the run summary shows when that happens).
# LLM_BALANCE_MIN   abort the run (exit 69) below this           (default 1.00)
# LLM_BALANCE_WARN  print a "top up soon" warning below this     (default 5.00)
# POSTURI_SKIP_BALANCE_CHECK=1 bypasses the check entirely (an env var, not read from here).
LLM_BALANCE_MIN=
LLM_BALANCE_WARN=

# Push notifications (ops/ntfy.py, through https://ntfy.sh). Install the ntfy app and
# subscribe to the topic. On the public server the topic is the only secret -- anyone who
# knows it can read it and post to it -- so make it long and random, and keep it out of git:
#     echo "posturi-$(openssl rand -hex 8)"
# What you get: one message per finished run (outcome, postings, LLM cost, export checks,
# balance left), a failure message for a run that did not deploy, and the low-balance
# alert (urgent when a slot is aborted, otherwise at most once a day).
# Check the wiring with:  .venv/bin/python ops/ntfy.py test
#
# NTFY_TOPIC    blank turns every push off
# NTFY_URL      the server; blank is https://ntfy.sh (set it to use a self-hosted one)
# NTFY_SUMMARY  `off` keeps only what needs attention: failed or degraded runs and a
#               balance under the abort level. Blank sends one message per run.
NTFY_TOPIC=
NTFY_URL=
NTFY_SUMMARY=
