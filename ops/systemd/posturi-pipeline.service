# /etc/systemd/system/posturi-pipeline.service
#
# Written for the live box (gov2-1): the checkout is /home/pax/g2-dev/posturi.gov.ro
# and runs as pax. The /srv/posturi + `posturi` user layout in docs/deploy-vps.md
# §1–§5 is the reference install; change User/Group and the three paths if you
# follow it. Install and switch over from cron in ONE step (OPS-01):
#
#   sudo cp ops/systemd/posturi-pipeline.* /etc/systemd/system/
#   sudo systemctl daemon-reload
#   crontab -l | grep -v 'posturi.gov.ro/ops/run-pipeline.sh' | crontab -   # drop the 2 cron lines
#   sudo systemctl enable --now posturi-pipeline.timer
#   systemctl list-timers posturi-pipeline.timer        # next: 13:15 or 18:33 Bucharest
#
# Output is appended to logs/pipeline.log, exactly where the cron redirect put it,
# so logrotate (ops/logrotate.posturi) and /pipeline-check keep working — and pax
# cannot read a system unit's journal (not in adm/systemd-journal).
[Unit]
Description=posturi.gov.ro pipeline — scrape, enrich, export, deploy
Documentation=file:/home/pax/g2-dev/posturi.gov.ro/docs/deploy-vps.md
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=pax
Group=pax
WorkingDirectory=/home/pax/g2-dev/posturi.gov.ro
ExecStart=/home/pax/g2-dev/posturi.gov.ro/ops/run-pipeline.sh
# systemd >= 240. Same file, same append semantics as the old cron redirect.
StandardOutput=append:/home/pax/g2-dev/posturi.gov.ro/logs/pipeline.log
StandardError=append:/home/pax/g2-dev/posturi.gov.ro/logs/pipeline.log

# API keys are NOT loaded here. systemd's EnvironmentFile keeps everything after the
# "=" including a trailing "# comment", which would silently corrupt a key. The
# Python entry points read .env through python-dotenv, and deploy-php.sh through
# ops/env.sh; both parse it properly.
Environment=TZ=Europe/Bucharest
Environment=PYTHONUNBUFFERED=1

# The scrape sleeps between pages and the LLM step waits on the network, so the run
# is long and mostly idle. Let anything else on the box go first.
Nice=10
IOSchedulingClass=idle

# A run can legitimately take hours on a first backfill; 6h is the ceiling, past
# which something is wedged. flock inside the script stops slots from overlapping.
TimeoutStartSec=6h

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# No ProtectHome: the deploy step's ssh reads ~/.ssh and may need to write known_hosts.

[Install]
WantedBy=multi-user.target
