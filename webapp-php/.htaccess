Options -Indexes

RewriteEngine On

# Block direct access to the SQLite database and its journal sidecars
<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|db)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# The source stylesheet and the dev-only router are never needed at runtime;
# deploy-php.sh excludes them, this is the belt-and-braces.
<FilesMatch "^(router\.php)$">
    Order allow,deny
    Deny from all
</FilesMatch>
RedirectMatch 404 ^/assets/

# ---- Static assets ----
# app.css is cache-busted with ?v=<mtime>; fonts and htmx are content-immutable.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                    "access plus 1 year"
    ExpiresByType application/javascript      "access plus 1 year"
    ExpiresByType font/woff2                  "access plus 1 year"
    ExpiresByType image/svg+xml               "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
        application/javascript application/json application/xml \
        application/atom+xml text/calendar
</IfModule>

# woff2 predates some shared hosts' mime.types
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
</IfModule>

# Static files are served directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else → index.php
RewriteRule ^ index.php [L,QSA]
