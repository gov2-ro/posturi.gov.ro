Options -Indexes

RewriteEngine On

# Block direct access to the SQLite database and its journal sidecars
<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|db)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# The source stylesheet and the dev-only router are never needed at runtime;
# deploy-php.sh excludes them, this is the belt-and-braces.
<FilesMatch "^(router\.php)$">
    Order allow,deny
    Deny from all
</FilesMatch>
RedirectMatch 404 ^/assets/
# Editor leftovers (vim swap, backup copies) and dotfiles: never served. deploy-php.sh
# excludes them too; this also covers a copy that an earlier deploy left on the host.
<FilesMatch "(^\.|\.sw[op]$|~$|\.bak$|\.orig$)">
    Order allow,deny
    Deny from all
</FilesMatch>
# bin/ holds command-line tools (UX-14 alerts.php): never web-requestable.
RedirectMatch 404 ^/bin(/|$)

# ANOMALY-PUBLIC: HTTP basic auth for /admin/. The routes go through index.php, so the
# match is on the request URI. The password file is outside the web root and outside git;
# deploy-php.sh never uploads or deletes it (README: "Admin pages"). The IfModule guards
# skip the block on a host without Apache 2.4 auth modules; the PHP guard in
# pages/anomalies_admin.php then answers 403, so the page is never open.
<IfModule mod_authn_file.c>
<IfModule mod_auth_basic.c>
<If "%{REQUEST_URI} =~ m#^/admin(/|$)#">
    AuthType Basic
    AuthName "posturi.gov2.ro admin"
    AuthUserFile /home/pax/posturi-private/admin.htpasswd
    Require valid-user
</If>
</IfModule>
</IfModule>

# ---- Static assets ----
# app.css is cache-busted with ?v=<mtime>; fonts and htmx are content-immutable.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                    "access plus 1 year"
    ExpiresByType application/javascript      "access plus 1 year"
    ExpiresByType font/woff2                  "access plus 1 year"
    ExpiresByType image/svg+xml               "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
        application/javascript application/json application/xml \
        application/atom+xml text/calendar
</IfModule>

# woff2 predates some shared hosts' mime.types
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
</IfModule>

# Static files are served directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else → index.php
RewriteRule ^ index.php [L,QSA]
