# Local Postgres (brew services) — default
DATABASE_URL=postgres://localhost/posturi_dev

# Docker Compose Postgres (docker compose up db) — use port 5433
# DATABASE_URL=postgres://posturi:posturi@localhost:5433/posturi_dev

SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=1

# LLM inference (for infer_postings --provider)
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
